---
/**
 * Footer — global site footer (link grid + legal bar). Ported from the upstream
 * Starlight override (src/components/overrides/Footer.astro); the Starlight-only
 * Pagination/EditLink/Feedback bits are dropped since DocsLayout owns those.
 * Rendered once in BaseLayout, so it appears on every page.
 */
import { AUDT_CONTACT_HREF, AUDT_SITE_HREF } from "../../config/site";

interface Props {
	/** Extra classes on the <footer> — e.g. a top margin on pages without a
	 *  decorative backdrop, where the footer isn't meant to sit flush. */
	class?: string;
	/** Horizontal envelope for the inner container. "landing" (default) matches
	 *  the PageShell 1120px envelope; "docs" matches the DocsLayout content column
	 *  (same max-width, centering and padding) so the footer lines up with the
	 *  page content. The caller reserves the TOC gutter so centering matches. */
	envelope?: "landing" | "docs";
	/** Docs-envelope only: mirror the content wrapper's `wide` max-width so the
	 *  footer stays aligned on wide pages. */
	wide?: boolean;
}

const { class: className, envelope = "landing", wide = false } = Astro.props;

const innerClass =
	envelope === "docs"
		? `mx-auto w-full px-4 lg:px-6 py-12 ${wide ? "max-w-[1400px]" : "max-w-(--nb-content-max)"}`
		: "mx-auto w-full max-w-[1120px] px-[max(1.5rem,4vw)] py-12";

type FooterLink = { text: string; href: string };

const groups: [string, FooterLink[]][] = Object.entries({
	Documentação: [
		{ text: "E-commerce", href: "/e-commerce/" },
		{ text: "Conectores", href: "/conectores/" },
		{ text: "Governança e LGPD", href: "/governanca-e-lgpd/" },
		{ text: "MCP", href: "/mcp/" },
	],
	Integrações: [
		{ text: "Google Ads", href: "/conectores/google/google-ad/" },
		{
			text: "Google Analytics 4",
			href: "/conectores/google/google-analytics/",
		},
		{ text: "Meta Ads", href: "/conectores/meta-ads/facebook-ads/" },
		{ text: "VTEX", href: "/conectores/vtex/" },
	],
	Audt: [
		{ text: "Site institucional", href: AUDT_SITE_HREF },
		{ text: "Entrar em contato", href: AUDT_CONTACT_HREF },
	],
});

const ecosystemBrands = [
	{
		label: "Tech Intelligence",
		light: "/integrations/tech-intelligence-dark.avif",
		dark: "/integrations/tech-intelligence-light.avif",
	},
	{
		label: "Caaqui",
		light: "/integrations/caaqui.avif",
		darkTreatment: "white",
	},
];

const year = new Date().getFullYear();
---

<footer class:list={[className]}>
	{
		/* Inner container matches the page's content envelope so footer edges line
      up with page content instead of running full-bleed. */
	}
	<div class={innerClass}>
		<div class="grid grid-cols-2 gap-8 md:grid-cols-3">
			{
				groups.map(([title, items]) => (
					<ul class="m-0 flex list-none flex-col gap-3 pl-0">
						<li class="text-foreground text-xs font-semibold">{title}</li>
						{items.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm no-underline transition-colors"
								>
									{link.text}
								</a>
							</li>
						))}
					</ul>
				))
			}
		</div>

		<div
			class="border-border mt-10 flex flex-col gap-5 border-t pt-6 sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="text-muted-foreground m-0 text-xs font-medium">
				Ecossistema Audt
			</p>
			<div class="flex flex-wrap items-center gap-6 sm:justify-end">
				{
					ecosystemBrands.map((brand) => (
						<div
							class="ecosystem-logo-stage"
							role="img"
							aria-label={brand.label}
						>
							<img
								src={brand.light}
								alt=""
								loading="lazy"
								decoding="async"
								class:list={[
									"ecosystem-logo",
									brand.dark && "ecosystem-logo--light",
									brand.darkTreatment === "white" &&
										"ecosystem-logo--white-on-dark",
								]}
							/>
							{brand.dark && (
								<img
									src={brand.dark}
									alt=""
									loading="lazy"
									decoding="async"
									class="ecosystem-logo ecosystem-logo--dark"
								/>
							)}
						</div>
					))
				}
			</div>
		</div>

		<div class="border-border mt-6 border-t pt-6">
			<p class="text-muted-foreground m-0 text-center text-xs">
				© {year} Audt.AI
			</p>
		</div>
	</div>
</footer>

<style>
	.ecosystem-logo-stage {
		display: grid;
		inline-size: 8.5rem;
		block-size: 2.75rem;
		place-items: center;
	}
	.ecosystem-logo {
		grid-area: 1 / 1;
		inline-size: 100%;
		block-size: 100%;
		object-fit: contain;
	}
	.ecosystem-logo--dark {
		display: none;
	}
	:global(:root[data-mode="dark"]) .ecosystem-logo--light {
		display: none;
	}
	:global(:root[data-mode="dark"]) .ecosystem-logo--dark {
		display: block;
	}
	:global(:root[data-mode="dark"]) .ecosystem-logo--white-on-dark {
		filter: brightness(0) invert(1);
	}
</style>
