---
import { Icon } from "astro-icon/components";
import CornerMarks from "@/components/CornerMarks.astro";
import { LinkButton } from "@/components/ui/link-button";
import SectionHeading from "./SectionHeading.astro";
import TabBar from "./TabBar.astro";

const primitives = [
	{
		id: "conectar",
		label: "Conectar",
		icon: "ph:plugs-connected",
		iconColor: "#1447e6",
		iconBg: "rgba(20, 71, 230, 0.08)",
		iconBgDark: "rgba(75, 127, 255, 0.16)",
		heading: "Conecte as fontes sem desmontar o seu stack",
		description:
			"A Audt recebe dados por APIs, arquivos, armazenamento de objetos ou visões governadas. O formato de entrega é definido com o seu time e respeita a fonte de autoridade de cada domínio.",
		input: "Comércio, catálogo, estoque, analytics e mídia",
		output: "Fluxos versionados, observáveis e com menor privilégio",
		cta: {
			label: "Entenda os conectores",
			href: "/conectores/",
		},
		tags: [
			{ label: "APIs", href: "/conectores/" },
			{ label: "CSV ou Parquet", href: "/conectores/" },
			{ label: "BigQuery", href: "/conectores/google/bigquery/" },
		],
	},
	{
		id: "normalizar",
		label: "Normalizar",
		icon: "ph:arrows-merge",
		iconColor: "#7c3aed",
		iconBg: "rgba(124, 58, 237, 0.08)",
		iconBgDark: "rgba(139, 92, 246, 0.18)",
		heading: "Crie uma linguagem comum para a operação",
		description:
			"Mapeamos identificadores, status, datas, moedas e granularidade para um contrato lógico. A nomenclatura de origem pode continuar como está; a tradução fica explícita e rastreável.",
		input: "Dicionários, amostras e regras de negócio",
		output: "Chaves estáveis e métricas comparáveis entre fontes",
		cta: { label: "Veja o contrato de dados", href: "/e-commerce/" },
		tags: [
			{ label: "Pedidos", href: "/e-commerce/pedidos/" },
			{ label: "Catálogo", href: "/e-commerce/catalogo-de-produtos/" },
			{ label: "Estoque", href: "/e-commerce/estoque-de-produtos/" },
		],
	},
	{
		id: "reconciliar",
		label: "Reconciliar",
		icon: "ph:circles-three-plus",
		iconColor: "#db2777",
		iconBg: "rgba(219, 39, 119, 0.08)",
		iconBgDark: "rgba(236, 72, 153, 0.16)",
		heading: "Explique as diferenças em vez de escondê-las",
		description:
			"Receita financeira, conversões de mídia e eventos de analytics respondem a perguntas diferentes. A Audt preserva cada definição, documenta as divergências e produz uma visão reconciliada.",
		input: "Totais por fonte, janela e regra de atribuição",
		output: "Qualidade mensurável, cobertura e divergências conhecidas",
		cta: { label: "Conheça a governança", href: "/governanca-e-lgpd/" },
		tags: [
			{ label: "Receita", href: "/e-commerce/pedidos/" },
			{ label: "Mídia", href: "/conectores/" },
			{ label: "Analytics", href: "/conectores/google/google-analytics/" },
		],
	},
	{
		id: "decidir",
		label: "Decidir",
		icon: "ph:sparkle",
		iconColor: "#6d00f5",
		iconBg: "rgba(109, 0, 245, 0.08)",
		iconBgDark: "rgba(139, 65, 255, 0.2)",
		heading: "Leve contexto confiável para cada decisão",
		description:
			"Indicadores, diagnósticos e recomendações passam a compartilhar as mesmas regras de negócio. O contexto pode ser usado na Audt ou em assistentes compatíveis com MCP.",
		input: "Dados reconciliados, metas e contexto comercial",
		output: "Respostas rastreáveis, alertas e próximos passos",
		cta: {
			label: "Explore o MCP",
			href: "/mcp/",
		},
		tags: [
			{ label: "Diagnósticos", href: "/mcp/" },
			{ label: "Alertas", href: "/mcp/" },
			{ label: "Assistentes", href: "/mcp/" },
		],
	},
];
---

<section class="pt-10 pb-6 lg:pt-14" aria-labelledby="build-heading" id="build">
	<SectionHeading id="build-heading" class="mb-8">
		Inteligência integrada ao seu e-commerce
	</SectionHeading>

	<div class="border-border relative overflow-visible border">
		<CornerMarks />

		<TabBar
			name="build"
			variant="underline"
			aria-label="Etapas da inteligência Audt"
			tabs={primitives.map((p) => ({ id: p.id, label: p.label }))}
		/>

		{
			primitives.map((p, i) => (
				<div
					role="tabpanel"
					id={`build-panel-${p.id}`}
					aria-labelledby={`build-tab-${p.id}`}
					data-tabbar="build"
					data-tab-id={p.id}
					hidden={i !== 0}
					class="bg-card p-5 sm:p-8"
				>
					<div class="w-full">
						<div class="mb-4 flex items-center gap-3">
							<div
								class="build-panel-icon flex size-8 shrink-0 items-center justify-center rounded border border-dashed"
								style={`--build-icon-color:${p.iconColor};--build-icon-bg:${p.iconBg};--build-icon-bg-dark:${p.iconBgDark};`}
							>
								<Icon name={p.icon} size="16px" />
							</div>
							<h3 class="text-foreground text-base leading-snug font-medium md:text-lg">
								{p.heading}
							</h3>
						</div>
						<p class="text-muted-foreground mb-6 max-w-[780px] text-sm leading-relaxed md:text-base">
							{p.description}
						</p>

						<div class="border-border bg-border mb-6 grid max-w-[860px] gap-px overflow-hidden rounded-lg border sm:grid-cols-2">
							<div class="bg-background p-4">
								<span class="text-muted-foreground block text-xs font-medium tracking-wider uppercase">
									O que entra
								</span>
								<p class="text-foreground mt-1.5 mb-0 text-sm leading-relaxed">
									{p.input}
								</p>
							</div>
							<div class="bg-background p-4">
								<span class="text-muted-foreground block text-xs font-medium tracking-wider uppercase">
									O que sai
								</span>
								<p class="text-foreground mt-1.5 mb-0 text-sm leading-relaxed">
									{p.output}
								</p>
							</div>
						</div>

						<div class="flex w-full flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
							<LinkButton href={p.cta.href} variant="secondary" size="base">
								{p.cta.label}
								<Icon name="ph:arrow-right" class="h-3 w-3" />
							</LinkButton>
							<p class="text-muted-foreground relative top-px min-w-0 flex-1 text-sm">
								{p.tags.map((tag, idx) => (
									<span class="inline-flex items-center">
										<a
											href={tag.href}
											class="text-foreground no-underline hover:underline hover:underline-offset-4"
										>
											{tag.label}
										</a>
										{idx < p.tags.length - 1 && (
											<span class="text-border mx-1.5" aria-hidden="true">
												·
											</span>
										)}
									</span>
								))}
							</p>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.build-panel-icon {
		color: var(--build-icon-color);
		border-color: var(--build-icon-color);
		background: var(--build-icon-bg);
	}
	:global(:root[data-mode="dark"]) .build-panel-icon {
		background: var(--build-icon-bg-dark);
	}
</style>
