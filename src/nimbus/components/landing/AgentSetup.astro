---
import { Icon } from "astro-icon/components";
import CornerMarks from "@/components/CornerMarks.astro";
import SectionHeading from "./SectionHeading.astro";
import { LinkButton } from "@/components/ui/link-button";
import { AUDT_CONTACT_HREF } from "../../../config/site";

const providers = [
	{ label: "Google Ads", light: "/integrations/google-ads.svg", scale: 0.92 },
	{
		label: "Google Analytics",
		light: "/integrations/google-analytics-lockup.svg",
		scale: 1.45,
		darkFilter: "preserve",
	},
	{
		label: "BigQuery",
		light: "/integrations/google-bigquery-lockup.svg",
		scale: 1.45,
		darkFilter: "preserve",
	},
	{
		label: "Meta",
		light: "/integrations/meta-light.svg",
		dark: "/integrations/meta-dark.svg",
		scale: 1.9,
	},
	{ label: "VTEX", light: "/integrations/vtex-lockup.svg", scale: 1.15 },
	{
		label: "TikTok",
		light: "/integrations/tiktok-wordmark-light.svg",
		dark: "/integrations/tiktok-wordmark-dark.svg",
		scale: 1.4,
	},
	{
		label: "AppsFlyer",
		light: "/integrations/appsflyer-light.svg",
		dark: "/integrations/appsflyer-dark.svg",
		scale: 1.15,
	},
	{
		label: "Firebase",
		light: "/integrations/firebase-light.svg",
		dark: "/integrations/firebase-dark.svg",
		scale: 1,
	},
	{
		label: "Shopify",
		light: "/integrations/shopify-light.svg",
		dark: "/integrations/shopify-dark.svg",
		scale: 1,
	},
	{
		label: "Salesforce",
		light: "/integrations/salesforce-light.svg",
		dark: "/integrations/salesforce-dark.svg",
		scale: 1,
	},
	{
		label: "Snowflake",
		light: "/integrations/snowflake-light.svg",
		dark: "/integrations/snowflake-dark.svg",
		scale: 1,
	},
	{
		label: "Databricks",
		light: "/integrations/databricks-light.svg",
		dark: "/integrations/databricks-dark.svg",
		scale: 1,
	},
	{
		label: "Wake",
		light: "/integrations/wake-light.svg",
		dark: "/integrations/wake-dark.svg",
		scale: 3.6,
	},
];
---

<section
	id="agent-setup"
	class="pt-10 pb-6 lg:pt-14"
	aria-labelledby="agents-heading"
>
	<div class="mb-6 sm:mb-8">
		<SectionHeading id="agents-heading" class="mb-2">
			Conecte os principais provedores
		</SectionHeading>
		<p
			class="text-muted-foreground mt-0 max-w-[720px] text-sm leading-relaxed text-pretty md:text-lg"
		>
			Integrações prontas e fluxos sob medida para centralizar decisões sem
			forçar a troca dos sistemas que já operam o seu negócio.
		</p>
	</div>

	<div class="border-primary/20 bg-primary/20 relative overflow-visible border">
		<CornerMarks />

		<div
			class="provider-grid bg-primary/20 grid grid-cols-2 gap-px sm:grid-cols-3"
		>
			{
				providers.map((provider) => (
					<div class="provider-card bg-background/95 flex min-h-32 flex-col items-center justify-center gap-2 p-4 text-center">
						<div
							class="provider-logo-stage"
							style={`--logo-scale:${provider.scale};`}
						>
							<img
								src={provider.light}
								alt=""
								loading="lazy"
								decoding="async"
								class:list={[
									"provider-logo",
									provider.dark && "provider-logo--light",
									provider.darkFilter === "preserve" &&
										"provider-logo--preserve-on-dark",
								]}
							/>
							{provider.dark && (
								<img
									src={provider.dark}
									alt=""
									loading="lazy"
									decoding="async"
									class="provider-logo provider-logo--dark"
								/>
							)}
						</div>
						<span class="text-muted-foreground text-xs font-medium">
							{provider.label}
						</span>
					</div>
				))
			}
		</div>
		<div
			class="bg-background/95 border-primary/20 flex flex-col items-start justify-between gap-5 border-t p-5 sm:flex-row sm:items-center sm:p-6"
		>
			<div>
				<p class="text-foreground m-0 text-base font-medium">
					Soluções sob medida para o seu ERP
				</p>
				<p
					class="text-muted-foreground mt-1 mb-0 max-w-[68ch] text-sm leading-relaxed"
				>
					Hoje, a implantação é acompanhada pelo time Audt. A disponibilidade e
					o escopo de cada fonte são confirmados no onboarding; o marketplace
					self-service está em evolução.
				</p>
			</div>
			<LinkButton
				href={AUDT_CONTACT_HREF}
				variant="primary"
				class="shrink-0 sm:ml-auto"
				size="lg"
			>
				Falar com especialista
				<Icon name="ph:arrow-right" class="h-4 w-4" />
			</LinkButton>
		</div>
	</div>
</section>

<style>
	.provider-logo-stage {
		display: grid;
		inline-size: min(9rem, 100%);
		block-size: 3.5rem;
		place-items: center;
		overflow: hidden;
	}
	.provider-logo {
		grid-area: 1 / 1;
		inline-size: 8rem;
		block-size: 2.75rem;
		object-fit: contain;
		transform: scale(var(--logo-scale, 1));
	}
	.provider-logo--dark {
		display: none;
	}
	@media (min-width: 1024px) {
		.provider-grid {
			grid-template-columns: repeat(20, minmax(0, 1fr));
		}
		.provider-card {
			grid-column: span 4;
		}
		.provider-card:nth-child(n + 6) {
			grid-column: span 5;
		}
		.provider-card:nth-child(6),
		.provider-card:nth-child(10) {
			grid-column: 1 / span 5;
		}
	}
	:global(:root[data-mode="dark"]) .provider-logo--light {
		display: none;
	}
	:global(:root[data-mode="dark"]) .provider-logo--dark {
		display: block;
	}
	:global(:root[data-mode="dark"]) .provider-logo--preserve-on-dark {
		filter: invert(1) hue-rotate(180deg) brightness(1.05);
	}
</style>
