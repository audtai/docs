---
import CornerMarks from "@/components/CornerMarks.astro";
import SectionHeading from "./SectionHeading.astro";

const cards = [
	{
		label: "Conectores",
		heading: "Integração assistida",
		desc: "A Audt configura o acesso, valida o histórico e monitora a coleta com o seu time. Ideal para APIs de comércio, analytics e mídia.",
		links: [{ label: "Ver conectores", href: "/conectores/" }],
	},
	{
		label: "Dados governados",
		heading: "Entrega controlada pelo cliente",
		desc: "Consuma apenas visões, tabelas ou arquivos aprovados. O contrato lógico da Audt é mapeado sem expor o seu modelo interno.",
		links: [
			{ label: "Preparar os dados", href: "/e-commerce/" },
			{ label: "Revisar segurança", href: "/governanca-e-lgpd/" },
		],
	},
	{
		label: "MCP",
		heading: "Contexto para os seus assistentes",
		desc: "Use ferramentas autorizadas da Audt em clientes compatíveis com MCP, mantendo o escopo e as permissões da sua organização.",
		links: [{ label: "Conhecer o MCP", href: "/mcp/" }],
	},
];
---

<section
	id="community"
	class="pt-10 pb-10 lg:pt-14 lg:pb-12"
	aria-labelledby="community-heading"
>
	<div class="mb-6 sm:mb-8">
		<SectionHeading id="community-heading" class="mb-2">
			Escolha a rota de integração
		</SectionHeading>
		<p
			class="text-muted-foreground max-w-[600px] text-sm leading-relaxed text-pretty md:text-lg"
		>
			Comece pela forma de acesso que melhor se encaixa na arquitetura, na
			governança e no ritmo da sua operação.
		</p>
	</div>

	<div
		class="border-border bg-border relative grid grid-cols-1 gap-px overflow-visible border md:grid-cols-3"
	>
		<CornerMarks />

		{
			cards.map((card) => (
				<div class="community-card bg-background flex flex-col p-6">
					<span class="text-primary font-mono text-xs tracking-widest uppercase">
						{card.label}
					</span>
					<h3 class="text-foreground mt-3 mb-2 text-base leading-snug font-medium md:text-lg">
						{card.heading}
					</h3>
					<p class="text-muted-foreground mb-6 flex-1 text-sm leading-relaxed md:text-base">
						{card.desc}
					</p>

					<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
						{card.links.map((link) => (
							<a
								href={link.href}
								class="text-muted-foreground inline-flex w-fit items-center text-sm font-medium underline-offset-4 hover:underline"
							>
								{link.label}
							</a>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>
